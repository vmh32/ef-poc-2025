{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EdiConsole": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss "
      },
      "LogToStandardErrorThreshold": "Trace"
    }
  },
  "Ingestion": {
    "SnipLevel": 4
  }
}
